#!/usr/bin/env bash
# Aja komento Kindlellä telnetin kautta: scripts/kindle-sh "<komento>"
# KINDLE_SH_WAIT = sekunteja komennon jälkeen (oletus 3), hitaille komennoille.
set -euo pipefail

if [ $# -lt 1 ] || [ -z "$1" ]; then
    echo "käyttö: $(basename "$0") \"<komento>\"" >&2
    exit 2
fi

WAIT="${KINDLE_SH_WAIT:-3}"
KINDLE_IP="${KINDLE_IP:-192.168.0.186}"

if ! nc -z -w 3 "$KINDLE_IP" 23 2>/dev/null; then
    echo "Kindle ei vastaa osoitteessa $KINDLE_IP – tarkista IP Kindlen näytöltä (Kehitysyhteys)" >&2
    exit 1
fi

# busybox telnetd neuvottelee ensin; komento lähetetään vasta sekunnin päästä.
{
    sleep 1
    printf '%s\r\n' "$1"
    sleep "$WAIT"
    printf 'exit\r\n'
    sleep 1
} | nc -w $((WAIT + 5)) "$KINDLE_IP" 23 \
    | LC_ALL=C tr -cd '\11\12\15\40-\176' \
    | LC_ALL=C tr -d '\r' \
    | { grep -vF '[root@kindle' || true; }
